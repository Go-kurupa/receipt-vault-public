{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "receiptsMcp",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": {
          "functionId": "receiptsOauth",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "function": {
          "functionId": "receiptsOauth",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/**",
        "function": {
          "functionId": "receiptsOauth",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/oauth/**",
        "function": {
          "functionId": "receiptsOauth",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    },
    {
      "source": "mcp",
      "codebase": "mcp",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "src",
        "scripts",
        "*.test.ts",
        "vitest.config.ts",
        "tsconfig.json",
        "build.mjs"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run bundle"
      ]
    }
  ]
}
